{
    "name": "a3-problem-solving-monorepo",
    "private": true,
    "description": "A3 problem-solving report rendering for markdown: shared core, Obsidian plugin and VS Code extension",
    "workspaces": [
        "packages/core",
        "packages/obsidian",
        "packages/vscode"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "test": "npm test --workspaces --if-present",
        "dev:obsidian": "npm run dev --workspace packages/obsidian",
        "dev:vscode": "npm run dev --workspace packages/vscode"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "esbuild": "^0.28.2",
        "jsdom": "^29.1.1",
        "tslib": "^2.6.2",
        "typescript": "^5.4.5",
        "vitest": "^4.1.11"
    }
}
