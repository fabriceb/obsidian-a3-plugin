{
    "name": "obsidian-a3-plugin",
    "version": "0.1.3",
    "description": "Obsidian plugin that renders markdown notes as Toyota-style A3 problem-solving reports",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "esbuild": "^0.21.5",
        "obsidian": "^1.5.7",
        "tslib": "^2.6.2",
        "typescript": "^5.4.5"
    },
    "dependencies": {
        "mermaid": "^11.17.0"
    }
}
